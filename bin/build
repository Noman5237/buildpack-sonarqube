#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/lib.sh
source "${SCRIPT_DIR}/lib.sh"

LAYERS_DIR="${1:-/layers}"
PLATFORM_DIR="${2:-}"
PLAN_PATH="${3:-}"
BUILD_DIR="${4:-$(pwd)}"

cd "$BUILD_DIR"

sonar_api_get() {
  local path="$1"
  local data_key="$2"
  local data_value="$3"
  local base_url="${BP_SONARQUBE_URL%/}"

  if [[ -n "$data_key" ]]; then
    curl -sS --fail --get \
      --data-urlencode "${data_key}=${data_value}" \
      -u "${BP_SONARQUBE_APIKEY}:" \
      "${base_url}${path}"
  else
    curl -sS --fail \
      -u "${BP_SONARQUBE_APIKEY}:" \
      "${base_url}${path}"
  fi
}

sonar_api_post() {
  local path="$1"; shift
  local base_url="${BP_SONARQUBE_URL%/}"
  curl -sS --fail -X POST \
    -u "${BP_SONARQUBE_APIKEY}:" \
    "${base_url}${path}" \
    "$@"
}

# ── detect already validated: ENABLED=true, URL, APIKEY, identity pair, pom.xml ──

strict="${BP_SONARQUBE_STRICT:-false}"
auto_create="${BP_SONARQUBE_AUTO_CREATE_PROJECT:-true}"

strict_status=0
is_true "$strict" || strict_status=$?
[[ "$strict_status" -ne 2 ]] || fail "Invalid BP_SONARQUBE_STRICT value: ${strict}"
QUALITY_GATE_WAIT="false"
[[ "$strict_status" -ne 0 ]] || QUALITY_GATE_WAIT="true"

auto_create_status=0
is_true "$auto_create" || auto_create_status=$?
[[ "$auto_create_status" -ne 2 ]] || fail "Invalid BP_SONARQUBE_AUTO_CREATE_PROJECT value: ${auto_create}"

if [[ -n "${BP_SONARQUBE_PROJECT_NAME:-}" && -n "${BP_SONARQUBE_PROJECT_KEY:-}" ]]; then
  project_name="$BP_SONARQUBE_PROJECT_NAME"
  project_key="$BP_SONARQUBE_PROJECT_KEY"
  log "Project name: ${project_name} / key: ${project_key}"
else
  repo_name_slug="$(normalize_identifier "$BP_SONARQUBE_REPO_NAME")"
  repo_branch_slug="$(normalize_identifier "$BP_SONARQUBE_REPO_BRANCH")"
  project_name="${repo_name_slug}-${repo_branch_slug}"
  project_key="$project_name"
  log "Repository: ${BP_SONARQUBE_REPO_NAME} -> ${repo_name_slug} / ${BP_SONARQUBE_REPO_BRANCH} -> ${repo_branch_slug}"
  log "Generated project name/key: ${project_name}"
fi

if [[ -f "pom.xml" ]]; then
  project_type="maven"
elif [[ -f "build.gradle" || -f "build.gradle.kts" ]]; then
  project_type="gradle"
else
  log "No pom.xml or build.gradle found; nothing to do"
  exit 0
fi

log "Detected ${project_type} project for SonarQube analysis"

search_response="$(sonar_api_get '/api/projects/search' 'projects' "$project_key")"
if printf '%s' "$search_response" | grep -qF "\"key\":\"${project_key}\""; then
  log "SonarQube project ${project_key} already exists"
else
  [[ "$auto_create_status" -ne 1 ]] || fail "SonarQube project ${project_key} does not exist and auto-create is disabled"

  log "Creating SonarQube project ${project_key}"
  create_response="$(sonar_api_post '/api/projects/create' -d "project=$project_key" -d "name=$project_name")"
  printf '%s' "$create_response" | grep -qF '"project"' || fail "Failed to create SonarQube project ${project_key}"
  log "SonarQube project ${project_key} created"
fi

sonar_props="-Dsonar.host.url=${BP_SONARQUBE_URL}"
sonar_props="${sonar_props} -Dsonar.token=${BP_SONARQUBE_APIKEY}"
sonar_props="${sonar_props} -Dsonar.projectKey=${project_key}"
sonar_props="${sonar_props} -Dsonar.projectName=${project_name}"
sonar_props="${sonar_props} -Dsonar.qualitygate.wait=${QUALITY_GATE_WAIT}"
[[ -z "${BP_SONARQUBE_PROJECT_VERSION:-}" ]] || sonar_props="${sonar_props} -Dsonar.projectVersion=${BP_SONARQUBE_PROJECT_VERSION}"
[[ -z "${BP_SONARQUBE_EXTRA_ARGS:-}" ]] || sonar_props="${sonar_props} ${BP_SONARQUBE_EXTRA_ARGS}"

layer_dir="${LAYERS_DIR}/sonarqube-env"
env_dir="${layer_dir}/env"
mkdir -p "$env_dir"

cat > "${layer_dir}.toml" <<EOF
[types]
build = true
cache = false
launch = false
EOF

if [[ "$project_type" == "maven" ]]; then
  if [[ -n "${BP_SONARQUBE_MAVEN_PLUGIN_VERSION:-}" ]]; then
    sonar_goal="org.sonarsource.scanner.maven:sonar-maven-plugin:${BP_SONARQUBE_MAVEN_PLUGIN_VERSION}:sonar"
    log "Using pinned sonar-maven-plugin version: ${BP_SONARQUBE_MAVEN_PLUGIN_VERSION}"
  else
    sonar_goal="sonar:sonar"
  fi
  sonar_args="${sonar_goal} ${sonar_props}"
  printf '%s\n' "${sonar_args}" > "${env_dir}/BP_MAVEN_ADDITIONAL_BUILD_ARGUMENTS.override"
  log "SonarQube analysis appended to BP_MAVEN_ADDITIONAL_BUILD_ARGUMENTS (token redacted):"
else
  sonar_args="sonar ${sonar_props}"
  printf '%s\n' "${sonar_args}" > "${env_dir}/BP_GRADLE_ADDITIONAL_BUILD_ARGUMENTS.override"
  log "SonarQube analysis appended to BP_GRADLE_ADDITIONAL_BUILD_ARGUMENTS (token redacted):"
fi

log "${sonar_args//-Dsonar.token=*/"-Dsonar.token=***"}"
log "SonarQube buildpack completed"
