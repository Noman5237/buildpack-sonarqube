#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/lib.sh
source "${SCRIPT_DIR}/lib.sh"

platform_path="${1:-}"
plan_path="${2:-}"

enabled="${BP_SONARQUBE_ENABLED:-}"
enabled_status=0
is_true "$enabled" || enabled_status=$?
case "$enabled_status" in
  0) ;;
  1) log "BP_SONARQUBE_ENABLED is false or unset; buildpack optional skip"; exit 100 ;;
  2) fail "Invalid BP_SONARQUBE_ENABLED value: ${enabled}" ;;
esac

: "${BP_SONARQUBE_URL:?BP_SONARQUBE_URL is required when BP_SONARQUBE_ENABLED=true}"
: "${BP_SONARQUBE_APIKEY:?BP_SONARQUBE_APIKEY is required when BP_SONARQUBE_ENABLED=true}"

if [[ -n "${BP_SONARQUBE_PROJECT_NAME:-}" && -n "${BP_SONARQUBE_PROJECT_KEY:-}" ]]; then
  log "Using explicit project name: ${BP_SONARQUBE_PROJECT_NAME} / key: ${BP_SONARQUBE_PROJECT_KEY}"
else
  : "${BP_SONARQUBE_REPO_NAME:?BP_SONARQUBE_REPO_NAME + BP_SONARQUBE_REPO_BRANCH are required when BP_SONARQUBE_PROJECT_NAME and BP_SONARQUBE_PROJECT_KEY are not both set}"
  : "${BP_SONARQUBE_REPO_BRANCH:?BP_SONARQUBE_REPO_NAME + BP_SONARQUBE_REPO_BRANCH are required when BP_SONARQUBE_PROJECT_NAME and BP_SONARQUBE_PROJECT_KEY are not both set}"

  repo_name_slug="$(normalize_identifier "$BP_SONARQUBE_REPO_NAME")"
  [[ -n "$repo_name_slug" ]] || fail "BP_SONARQUBE_REPO_NAME must contain at least one letter or number after formatting"

  repo_branch_slug="$(normalize_identifier "$BP_SONARQUBE_REPO_BRANCH")"
  [[ -n "$repo_branch_slug" ]] || fail "BP_SONARQUBE_REPO_BRANCH must contain at least one letter or number after formatting"
fi

if [[ ! -f "pom.xml" ]]; then
  log "No pom.xml found; current Maven MVP does not apply"
  exit 100
fi

if [[ -n "$platform_path" ]]; then
  platform_path="${platform_path%/}/"
  log "platform_path: ${platform_path}"
fi

if [[ -n "$plan_path" ]]; then
  mkdir -p "$(dirname "$plan_path")"
  touch "$plan_path"
fi

log "SonarQube buildpack detected and enabled"
exit 0
